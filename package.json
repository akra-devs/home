{
  "name": "copy-of-akra-dev---product-builders",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "generate:brand": "node scripts/generate-brand-assets.mjs",
    "check:brand": "node scripts/generate-brand-assets.mjs --check",
    "check:products": "node scripts/check-products.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "typecheck": "tsc --noEmit",
    "prebuild": "npm run check:brand && npm run check:products",
    "build": "vite build",
    "postbuild": "node scripts/create-static-routes.mjs && node scripts/check-built-brand-assets.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "framer-motion": "^12.0.0",
    "lucide-react": "^0.562.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "sharp": "0.35.3",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
